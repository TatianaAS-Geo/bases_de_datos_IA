-- 15. Clientes y su máxima factura
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: { cuit: "$cliente.cuit", nombreCompleto: { $concat: ["$cliente.nombre", " ", "$cliente.apellido"] } },
      nroFactura: { $first: "$nroFactura" },
      totalFactura: { $sum: { $multiply: ["$item.precio", "$item.cantidad"] } }
  }},
  { $sort: { "_id.nombreCompleto": 1, totalFactura: -1 } }
]);

