-- 10. Productos con array de personas que lo compraron
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$item.producto",
      personas: { $addToSet: { $concat: ["$cliente.nombre", " ", "$cliente.apellido"] } }
  }},
  { $project: {
      producto: "$_id",
      personas: 1,
      _id: 0
  }}
]);
