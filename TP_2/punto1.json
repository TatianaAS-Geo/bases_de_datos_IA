
-- Región y cantidad total de productos vendidos a clientes de esa región

db.facturas.aggregate([
  { $unwind: "$item" },
  { 
    $group: {
      _id: "$cliente.region",
      totalProductosVendidos: { $sum: "$item.cantidad" }
    }
  }
]); 
{
