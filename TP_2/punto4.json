-- Reporte con nro. cuit, apellido, nombre, región y cantidad de facturas, ordenado por apellido

db.facturas.aggregate([
  { 
    $group: {
      _id: {
        cuit: "$cliente.cuit",
        apellido: "$cliente.apellido",
        nombre: "$cliente.nombre",
        region: "$cliente.region"
      },
      cantidadFacturas: { $sum: 1 }
    }
  },
  { $sort: { "_id.apellido": 1 } }
]);

