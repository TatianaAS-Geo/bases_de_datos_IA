-- 18. Total facturado por localidad
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$cliente.region",
      totalFacturado: { $sum: { $multiply: ["$item.precio", "$item.cantidad"] } }
  }}
]);
{
  _id: 'NOA',
