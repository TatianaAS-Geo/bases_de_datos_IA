-- 8. Total comprado y total ingresos por producto
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$item.producto",
      totalCantidad: { $sum: "$item.cantidad" },
      totalIngresos: { $sum: { $multiply: ["$item.precio", "$item.cantidad"] } }
  }}
]);
