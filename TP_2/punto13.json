-- 13. Promedio de gasto por factura por región
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$nroFactura",
      region: { $first: "$cliente.region" },
      totalFactura: { $sum: { $multiply: ["$item.precio", "$item.cantidad"] } }
  }},
  { $group: {
      _id: "$region",
      promedioGastoFactura: { $avg: "$totalFactura" }
  }}
]);
