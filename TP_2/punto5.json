-- 5. Clientes con CUIT > 27000000000
db.facturas.aggregate([
  { $group: {
      _id: {
          cuit: "$cliente.cuit",
          apellido: "$cliente.apellido",
          nombre: "$cliente.nombre",
          region: "$cliente.region"
      },
      cantidadFacturas: { $sum: 1 }
  }},
  { $match: { "_id.cuit": { $gt: 27000000000 } } },
  { $sort: { "_id.apellido": 1 } }
]);

