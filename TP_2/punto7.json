
-- Producto y cantiad de facturas en las que hubo compras ordenadas por la canitda de facturas de forma desc

db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$item.producto",
      cantidadFacturas: { $addToSet: "$nroFactura" }
  }},
  { $project: {
      producto: "$_id",
      cantidadFacturas: { $size: "$cantidadFacturas" }
  }},
  { $sort: { cantidadFacturas: -1 } }
]);

