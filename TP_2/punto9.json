--  9. Ordenar por ingresos ascendente, omitir 1ro y mostrar 2do y 3ro
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$item.producto",
      totalCantidad: { $sum: "$item.cantidad" },
      totalIngresos: { $sum: { $multiply: ["$item.precio", "$item.cantidad"] } }
  }},
  { $sort: { totalIngresos: 1 } },
  { $skip: 1 },
  { $limit: 2 }
]);

