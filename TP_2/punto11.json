-- 11. Productos ordenados por cantidad de personas distintas que lo compraron
db.facturas.aggregate([
  { $unwind: "$item" },
  { $group: {
      _id: "$item.producto",
      personas: { $addToSet: "$cliente.cuit" }
  }},
  { $project: {
      producto: "$_id",
      cantidadPersonas: { $size: "$personas" }
  }},
  { $sort: { cantidadPersonas: -1 } }
]);

